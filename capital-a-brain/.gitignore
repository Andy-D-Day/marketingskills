# ── DATA SAFETY ─────────────────────────────────────────────────────────────
# This repo fork is PUBLIC. Nothing containing real buyer names, deal real
# names, NDA records, financials, or codename↔realname mappings may be
# committed. Only code and generic templates belong in git.

# Source workbooks, exports, and any raw data
data/*
!data/overrides.example.json

# The ledger database (contains real names and NDA history)
ledger/*.db
ledger/*.db-*

# The vault (distilled notes contain real names and terms)
vault/*
!vault/.gitkeep

# Chroma embeddings (raw transcripts)
chroma/*
!chroma/.gitkeep

# Sync logs (may quote transcript/NDA content)
sync/log/

__pycache__/
*.pyc
