      "start_time": 518.74,
      "end_time": 521.94
    },
    {
      "text": "Okay.",
      "speaker_name": "Ahmed Zia",
      "start_time": 522.42,
      "end_time": 522.9
    },
    {
      "text": "Okay.",
      "speaker_name": "Ahmed Zia",
      "start_time": 522.9,
      "end_time": 523.26
