    },
    {
      "text": "Yeah.",
      "speaker_name": "Ahmed Zia",
      "start_time": 612.22,
      "end_time": 612.54
    },
    {
      "text": "Okay.",
      "speaker_name": "Ahmed Zia",
      "start_time": 612.78,
      "end_time": 613.34
    },
    {
      "text": "Yeah, My apologies.",
      "speaker_name": "Ahmed Zia",
      "start_time": 613.34,
      "end_time": 614.38
    },
    {
      "text": "So it's on the fourth, which is even better.",
