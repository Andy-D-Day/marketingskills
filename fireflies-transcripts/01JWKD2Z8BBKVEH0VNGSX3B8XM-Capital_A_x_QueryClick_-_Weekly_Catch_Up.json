      "start_time": 830.43,
      "end_time": 831.71
    },
    {
      "text": "Thank you.",
      "speaker_name": "Lee-Anne Lindsay",
      "start_time": 833.87,
      "end_time": 834.51
    },
    {
      "text": "Thanks, Amit.",
      "speaker_name": "Brian Fitzpatrick",
      "start_time": 837.63,
      "end_time": 838.43
    },
