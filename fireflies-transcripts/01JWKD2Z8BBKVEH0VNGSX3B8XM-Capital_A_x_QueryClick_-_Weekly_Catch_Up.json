      "end_time": 633.46
    },
    {
      "text": "I don't know why.",
      "speaker_name": "Richard Lewis",
      "start_time": 633.46,
      "end_time": 634.06
    },
    {
      "text": "It's.",
      "speaker_name": "Richard Lewis",
      "start_time": 634.22,
      "end_time": 634.46
    },
    {
      "text": "It's 4 o' clock.",
