      "start_time": 902.4,
      "end_time": 903.88
    },
    {
      "text": "Got it.",
      "speaker_name": "michaelsperling",
      "start_time": 904.36,
      "end_time": 905
    },
    {
      "text": "Okay.",
      "speaker_name": "michaelsperling",
      "start_time": 905.08,
      "end_time": 905.64
    },
    {
      "text": "All right.",
      "speaker_name": "michaelsperling",
      "start_time": 905.96,
      "end_time": 906.4
    },
    {
      "text": "I just, I have that here.",
