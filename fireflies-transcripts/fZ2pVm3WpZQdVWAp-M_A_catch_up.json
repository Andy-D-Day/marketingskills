    {
      "text": "Got the im, got it approved out today.",
      "speaker_name": "Jack Chiappe",
      "start_time": 316.897,
      "end_time": 319.393
    },
    {
      "text": "Okay.",
      "speaker_name": "David Tsutsumi",
      "start_time": 319.529,
      "end_time": 320.285
    },
    {
      "text": "So Ramon, there's a company called Noble Studio.",
