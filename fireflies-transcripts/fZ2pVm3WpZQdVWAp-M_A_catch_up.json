      "start_time": 286.565,
      "end_time": 287.285
    },
    {
      "text": "They've asked some questions.",
      "speaker_name": "Jack Chiappe",
      "start_time": 287.325,
      "end_time": 288.825
    },
    {
      "text": "Eileen's putting together responses.",
      "speaker_name": "Jack Chiappe",
      "start_time": 289.365,
      "end_time": 292.025
