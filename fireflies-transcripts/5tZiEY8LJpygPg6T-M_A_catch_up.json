    {
      "text": "As well as you did.",
      "speaker_name": "David Tsutsumi",
      "start_time": 301.16,
      "end_time": 303.736
    },
    {
      "text": "Send something out to publicists.",
      "speaker_name": "David Tsutsumi",
      "start_time": 303.768,
      "end_time": 306.82
