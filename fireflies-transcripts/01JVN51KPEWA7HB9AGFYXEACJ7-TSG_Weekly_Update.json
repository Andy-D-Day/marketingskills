      "start_time": 630.41,
      "end_time": 632.89
    },
    {
      "text": "Oh my God, it's so painful.",
      "speaker_name": "Stuart Tiedeman",
      "start_time": 633.85,
      "end_time": 635.09
    },
    {
      "text": "Painful, yeah.",
