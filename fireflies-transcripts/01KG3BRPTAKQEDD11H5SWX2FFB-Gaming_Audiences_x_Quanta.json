      "start_time": 48.17,
      "end_time": 49.45
    },
    {
      "text": "Oh, thank you.",
      "speaker_name": "Andrew Goldberg",
      "start_time": 50.25,
      "end_time": 51.21
    },
    {
      "text": "I don't know how I landed on it.",
