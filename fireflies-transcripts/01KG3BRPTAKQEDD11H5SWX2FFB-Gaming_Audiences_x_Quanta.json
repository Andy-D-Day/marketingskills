      "start_time": 57.13,
      "end_time": 60.63
    },
    {
      "text": "Spring coming in.",
      "speaker_name": "Ahmed Zia",
      "start_time": 61.11,
      "end_time": 62.23
    },
    {
      "text": "Well, I'm hoping for spring to come in.",
