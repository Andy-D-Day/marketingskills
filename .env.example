# Close.com CRM API
CLOSE_API_KEY=your_close_api_key_here

# Anthropic API (for valuation engine in Phase 2)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Webhooks (for notifications in Phase 4)
SLACK_WEBHOOK_LEADS=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_WEBHOOK_DAILY=https://hooks.slack.com/services/xxx/xxx/xxx

# Database path (defaults to ./data/outreach.db)
DATABASE_PATH=./data/outreach.db

# Processing controls
MAX_CONCURRENT_CRAWLS=5
CRAWL_DELAY_MS=3000
CRAWL_TIMEOUT_MS=15000
CONFIDENCE_THRESHOLD=60
BATCH_SIZE_DEFAULT=200
